# Copy to apps/worker/.env for local runs. On Railway, set these as service variables.

# Supabase → Project Settings → Database → connection string (session pooler, port 5432).
# The scheduler holds a session-level advisory lock, so don't use the transaction pooler.
DATABASE_URL=postgresql://postgres.your-project-ref:password@your-pooler-host.pooler.supabase.com:5432/postgres

# Private config repo (prompts, source registry, NSE holidays). Use ONE of these:
#   Local checkout (development):
PRIVATE_CONFIG_DIR=
#   Download from GitHub (Railway): a read-only fine-grained token with Contents access to that repo only.
#   Pin PRIVATE_CONFIG_REF to a commit SHA or tag so a prompt change reaches production only when you move the pin.
PRIVATE_CONFIG_REPO=
PRIVATE_CONFIG_REF=main
PRIVATE_CONFIG_TOKEN=
# Neither set means the public examples in apps/worker/examples/private-config (tests and local runs only).

# Gemini API key on the paid tier (PRD §9.1). Free-tier keys must not be used in production.
GEMINI_API_KEY=
# OpenRouter: bake-off and backup models (PRD §8.12).
OPENROUTER_API_KEY=

# Free-tier keys for the V0 data connectors (PRD §8.4). Upstox's daily access token is pasted
# into the web app's Settings page instead, since it expires every day at 03:30 IST.
FRED_API_KEY=
COINGECKO_API_KEY=

# Model per step as provider:model. Defaults are placeholders until the bake-off picks.
# LLM_EXTRACT=gemini:gemini-2.5-flash-lite
# LLM_VERIFY=gemini:gemini-2.5-flash
# LLM_VERIFY_BACKUP=openrouter:anthropic/claude-haiku-4.5

# The scheduler pings this every HEARTBEAT_SECONDS; the uptime monitor alerts when pings stop.
HEALTHCHECK_PING_URL=
HEARTBEAT_SECONDS=300
